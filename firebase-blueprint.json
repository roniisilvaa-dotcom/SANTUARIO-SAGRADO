{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing subscription status and spiritual momentum tracking.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Human name of the pilgrim"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Pilgrim email"
        },
        "joinedDate": {
          "type": "string",
          "description": "ISO timestamp of registration"
        },
        "streakCount": {
          "type": "integer",
          "description": "Spiritual momentum streak (days)"
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["free", "premium"],
          "description": "Elite status of premium devotion"
        },
        "subscriptionExpiresAt": {
          "type": "string",
          "description": "Expiration date of the premium membership"
        }
      },
      "required": ["name", "email", "joinedDate", "streakCount", "subscriptionStatus"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Sacred diary entry written during deep contemplations.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the memorial"
        },
        "date": {
          "type": "string",
          "description": "Readable localized date"
        },
        "text": {
          "type": "string",
          "description": "Devout journal entry text"
        },
        "emotion": {
          "type": "string",
          "description": "Emotion selected during check-in"
        },
        "reflection": {
          "type": "string",
          "description": "Divine or pastoral reflection text generated"
        },
        "prayerFocus": {
          "type": "string",
          "description": "Suggested scripture focus for prayer"
        }
      },
      "required": ["id", "date", "text", "emotion"]
    },
    "PrayerRequest": {
      "title": "PrayerRequest",
      "description": "Shared prayer requests where pilgrims can support each other.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique key"
        },
        "authorId": {
          "type": "string",
          "description": "User UID of author"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of author"
        },
        "text": {
          "type": "string",
          "description": "The prayer plea content"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of request"
        },
        "amenCount": {
          "type": "integer",
          "description": "Total number of Amens clicked"
        }
      },
      "required": ["id", "authorId", "authorName", "text", "createdAt", "amenCount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registry of pilgrim profiles"
    },
    "/users/{userId}/diary/{entryId}": {
      "schema": "JournalEntry",
      "description": "Personal journal reflections"
    },
    "/prayers/{prayerId}": {
      "schema": "PrayerRequest",
      "description": "Shared global wall of prayers for deep church solidarity"
    }
  }
}
